{
  "$schema": "http://json.schemastore.org/template",
  "author": "FinanceTracker",
  "classifications": [ "CQRS", "Feature" ],
  "identity": "FinanceTracker.Feature.Template",
  "name": "FinanceTracker Feature",
  "shortName": "financefeature",
  "sourceName": "FeatureTemplate",
  "symbols": {
    "includeValidator": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include FluentValidation validator files for Create and Update."
    },
    "entity": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Entity class name (e.g. Category). Defaults to the feature name."
    },
    "entityResolved": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "entity",
        "fallbackVariableName": "name"
      },
      "replaces": "EntityPlaceholder"
    },
    "dbSet": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "DbSet property name on IAppDbContext (e.g. Categories). Defaults to the entity name."
    },
    "dbSetResolved": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "dbSet",
        "fallbackVariableName": "entityResolved"
      },
      "replaces": "DbSetPlaceholder",
      "fileRename": "FolderTemplate"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!includeValidator)",
          "exclude": [
            "FolderTemplate/Create/CreateFeatureTemplateValidator.cs",
            "FolderTemplate/Update/UpdateFeatureTemplateValidator.cs"
          ]
        }
      ]
    }
  ]
}
