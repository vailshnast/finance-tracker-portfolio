    "/api/summary/monthly": {
      "get": {
        "tags": [
          "Summary"
        ],
        "summary": "Get monthly summary of income and expenses",
        "description": "Returns a summary of total income, total expenses, and net balance for the specified month and year. Use `month` and `year` query parameters to specify the period. Defaults to the current month and year if not provided.",
        "operationId": "GetSummary",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
