  "components": {
    "schemas": {
      "BudgetDetailResponse": {
        "required": [
          "id",
          "limit",
          "month",
          "year",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "limit": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "month": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "BudgetSummary": {
        "type": "object",
        "properties": {
