    "/api/categories": {
      "get": {
        "tags": [
          "Category"
        ],
        "summary": "Get all Categorys with pagination",
        "description": "Returns a paginated list of Categorys for the authenticated user. Use `page` and `pageSize` query parameters to control pagination. Defaults to page 1 with 10 items per page.",
