{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet run *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet ef migrations *)",
      "Bash(task *)"
    ],
    "ask": [
      "Bash(dotnet ef database update *)",
      "Bash(git push *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
